# OpenRouter key is required when the model client is wired.
OPENROUTER_API_KEY=

# Cost-conscious starting point: stronger GM, cheaper AI-player turns.
GM_MODEL=openai/gpt-6-luna
PLAYER_MODEL=qwen/qwen3.7-flash
# Set MODEL=... to use one model for both roles.

# Hidden reasoning per role: none | minimal | low | medium | high. Reasoning adds latency and cost;
# the keeper gets a little for rules judgement, AI players get none.
GM_REASONING=low
PLAYER_REASONING=none
# Where saves go (default: ~/.local/share/tabletop-ai/saves)
# TABLETOP_AI_SAVES=
# DEBUG=1 shows when the engine overrides the keeper (clamped harm, ignored countdown, ...)
